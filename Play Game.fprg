<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="feature and gameplay"/>
        <attribute name="authors" value="USER"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-08 11:53:56 AM"/>
        <attribute name="created" value="VVNFUjtERVNLVE9QLUNFVVJQOTM7MjAyNi0xMC0wODsxMDozODo1MSBBTTsyNjU5"/>
        <attribute name="edited" value="VVNFUjtERVNLVE9QLUNFVVJQOTM7MjAyNi0xMC0wODsxMTo1Mzo1NiBBTTs1OzI3NzQ="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <call expression="displayWelcome()"/>
            <declare name="secretNumber" type="Integer" array="False" size=""/>
            <assign variable="secretNumber" expression="getSecretNumber()"/>
            <call expression="playGame(secretNumber)"/>
        </body>
    </function>
    <function name="displayWelcome" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;=== WELCOME TO THE LUCKY NUMBER GAME ===&quot;" newline="True"/>
            <output expression="&quot;Guess a number between 1 and 10. You have 3 tries!&quot;" newline="True"/>
        </body>
    </function>
    <function name="getSecretNumber" type="Integer" variable="secret">
        <parameters/>
        <body>
            <declare name="secret" type="Integer" array="False" size=""/>
            <assign variable="secret" expression="Random(10) + 1"/>
        </body>
    </function>
    <function name="playGame" type="None" variable="">
        <parameters>
            <parameter name="secret" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="guess" type="Integer" array="False" size=""/>
            <declare name="attempts" type="Integer" array="False" size=""/>
            <declare name="maxAttempt" type="Integer" array="False" size=""/>
            <declare name="hasWon" type="Boolean" array="False" size=""/>
            <assign variable="attempts" expression="0"/>
            <assign variable="maxAttempts" expression="3"/>
            <assign variable="hasWon" expression="false"/>
            <while expression="attempts &lt; maxAttempts AND hasWon == false">
                <output expression="&quot;Hey bro, enter your move (1-9):&quot;" newline="True"/>
                <input variable="guess"/>
                <assign variable="attempts" expression="attempts + 1"/>
                <if expression="guess == secret">
                    <then>
                        <output expression="&quot;You win! You are the GOAT, you're so good!&quot;" newline="True"/>
                        <assign variable="hasWon" expression="true"/>
                    </then>
                    <else>
                        <if expression="guess &lt; secret">
                            <then>
                                <output expression="&quot;Too low! Try again.&quot;" newline="True"/>
                            </then>
                            <else>
                                <output expression="&quot;Too high! Try again.&quot;" newline="True"/>
                            </else>
                        </if>
                    </else>
                </if>
            </while>
            <if expression="hasWon == false">
                <then>
                    <output expression="&quot;Game Over! The secret number was: &quot; + secret" newline="True"/>
                </then>
                <else/>
            </if>
        </body>
    </function>
</flowgorithm>
